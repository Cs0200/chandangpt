{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clinicsync",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "clinicsync-db",
      "database_id": "9c679b88-426d-4966-a8bd-0bc7b066ba7b",
      "migrations_dir": "migrations",
    },
  ],
  "triggers": { "crons": ["0 3 * * *"] },
  "vars": { "ALLOW_SIGNUP": "true" },
}
